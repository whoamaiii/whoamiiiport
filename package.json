{
  "name": "whoamiii-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "check:ci": "npm run check && npm run test:e2e && npm run check:hygiene",
    "knip": "knip --no-progress",
    "audit:deps": "npm audit --audit-level=moderate",
    "check:hygiene": "npm run knip && npm run audit:deps",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:preview": "npm run build && playwright test --config=playwright.preview.config.ts",
    "optimize-images": "node scripts/optimize-images.js && npm run optimize-avif",
    "optimize-avif": "node scripts/generate-avif-images.mjs",
    "generate:curated-assets": "node scripts/generate-curated-portfolio-assets.mjs",
    "perf:mobile": "node scripts/measure-load-performance.mjs http://localhost:4173/"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource/barlow-condensed": "^5.2.8",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "knip": "^6.11.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.1",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.57.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
